<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- إذن الإشعارات (أندرويد 13+) لتذكيرات المهام والامتحانات.
         لا أذونات تخزين: الملفات تُختار عبر SAF وتُنسخ لتخزين التطبيق الداخلي. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- إذن الكاميرا لالتقاط صور الملاحظات، والميكروفون للتسجيل الصوتي.
         الكاميرا ليست إلزامية: التطبيق يعمل كاملاً على جهاز بلا كاميرا. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".UniHubApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UniHub.Splash"
        android:requestLegacyExternalStorage="false"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- مستقبل المشاركة: يُظهر التطبيق في قائمة مشاركة النظام (واتساب وغيره).
             ينسخ الملفات الواردة فوراً إلى «صندوق المشاركة» الداخلي لأن أذونات
             content:// مؤقتة وتموت مع النشاط — ثم يفتح التطبيق ليختار المستخدم
             المجلد الوجهة. يتعرّف أيضاً على شفرة ملفات النسخ الاحتياطي ويعرض
             حوار «هل تريد استيراد نسخة؟» بدل مسار المشاركة العادي. -->
        <activity
            android:name=".feature.share.ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.UniHub"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- مزود ملفات لفتح/مشاركة الملفات المستوردة عبر تطبيقات النظام -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- التهيئة عند الطلب (On-Demand Initialization) لـ WorkManager:
             التطبيق ينفّذ Configuration.Provider ليسلّم مصنع عمال Hilt، لذا يجب
             إزالة المهيّئ الافتراضي WorkManagerInitializer الذي تدمجه مكتبة
             work-runtime تلقائياً عبر androidx.startup — لولا الإزالة لتهيّأ
             WorkManager بالإعدادات الافتراضية قبل التطبيق وضاع HiltWorkerFactory،
             فتفشل عمال @HiltWorker (النسخ الاحتياطي التلقائي) وقت التشغيل. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
